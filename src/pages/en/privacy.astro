---
import Layout from '../../layouts/Layout.astro';
import Footer from '../../components/Footer.astro';
import { getTranslations } from '../../utils/translations';

const currentLocale = Astro.currentLocale || 'en';
const t = getTranslations(currentLocale);
---

<Layout title={`${t.privacyTitle} - ZJUAANC`}>
  <main class="flex-grow pt-24 pb-16 bg-warm min-h-[85vh] relative z-10">
    <div class="container mx-auto px-6 max-w-[800px]">
      <div class="bg-white rounded-3xl p-8 md:p-12 shadow-sm border border-primary/5">
        
        <!-- Header -->
        <h1 class="text-3xl font-extrabold text-primary mb-6 border-b border-primary/10 pb-4">
          {t.privacyTitle}
        </h1>
        
        <!-- Content -->
        <div class="text-text-light text-sm md:text-base leading-relaxed space-y-6">
          <p class="font-semibold text-primary/95 text-base bg-primary/5 p-4 rounded-xl border-l-4 border-accent">
            {t.privacySubtitle}
          </p>
          
          <!-- Sections -->
          <div class="space-y-4 pt-4">
            <h2 class="text-lg font-bold text-primary">{t.privacySection1Title}</h2>
            <p class="text-text-light/90">{t.privacySection1Content}</p>
          </div>

          <div class="space-y-4 pt-2">
            <h2 class="text-lg font-bold text-primary">{t.privacySection2Title}</h2>
            <p class="text-text-light/90">{t.privacySection2Content}</p>
          </div>

          <div class="space-y-4 pt-2">
            <h2 class="text-lg font-bold text-primary">{t.privacySection3Title}</h2>
            <p class="text-text-light/90">{t.privacySection3Content}</p>
          </div>

          <div class="space-y-4 pt-2">
            <h2 class="text-lg font-bold text-primary">{t.privacySection4Title}</h2>
            <p class="text-text-light/90">{t.privacySection4Content}</p>
          </div>

          <!-- Footer/Date -->
          <div class="pt-8 border-t border-primary/10 text-xs text-text-light/70 flex justify-between items-center">
            <span>{t.privacyLastUpdated}</span>
            <a href="/en" class="text-accent hover:text-accent-hover font-semibold transition-colors">
              &larr; Back to Home
            </a>
          </div>

        </div>
      </div>
    </div>
  </main>
  <Footer />
</Layout>
