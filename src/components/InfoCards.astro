---
import { getTranslations } from '../utils/translations';

const currentLocale = Astro.currentLocale || 'zh-tw';
const t = getTranslations(currentLocale);
---
<section class="py-20 md:py-28 bg-white relative">
  <div class="container mx-auto px-6 max-w-[1100px]">
    
    <!-- Section Title -->
    <div class="text-center max-w-[700px] mx-auto mb-16">
      <h2 class="text-xs uppercase tracking-widest text-accent font-bold mb-3">{t.detailsTag}</h2>
      <h3 class="text-3xl md:text-4xl font-bold text-primary">{t.detailsTitle}</h3>
      <p class="text-text-light mt-4 text-base md:text-lg">
        {t.detailsDesc}
      </p>
    </div>

    <!-- 4 Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
      
      <!-- Card 1: Time -->
      <div class="bg-warm/30 hover:bg-warm/50 border border-primary/5 rounded-2xl p-8 transition-all duration-300 hover:shadow-lg hover:-translate-y-1 group">
        <div class="w-12 h-12 bg-primary/10 rounded-xl flex items-center justify-center text-primary mb-6 group-hover:bg-primary group-hover:text-white transition-all duration-300">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
          </svg>
        </div>
        <h4 class="text-xl font-bold text-primary mb-3">{t.card1Title}</h4>
        <p class="text-text-light text-sm leading-relaxed">
          {t.card1Desc}
        </p>
      </div>

      <!-- Card 2: Location -->
      <div class="bg-warm/30 hover:bg-warm/50 border border-primary/5 rounded-2xl p-8 transition-all duration-300 hover:shadow-lg hover:-translate-y-1 group">
        <div class="w-12 h-12 bg-primary/10 rounded-xl flex items-center justify-center text-primary mb-6 group-hover:bg-primary group-hover:text-white transition-all duration-300">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 9V4.5M9 9H4.5M9 9 3.75 3.75M9 15v4.5M9 15H4.5M9 15 3.75 20.25M15 9V4.5M15 9h4.5M15 9 20.25 3.75M15 15v4.5M15 15h4.5M15 15 20.25 20.25" />
          </svg>
        </div>
        <h4 class="text-xl font-bold text-primary mb-3 font-sans">{t.card2Title}</h4>
        <p class="text-text-light text-sm leading-relaxed">
          <span class="text-accent font-semibold">{t.card2DescHighlight}</span> {t.card2DescText}
        </p>
      </div>

      <!-- Card 3: Method -->
      <div class="bg-warm/30 hover:bg-warm/50 border border-primary/5 rounded-2xl p-8 transition-all duration-300 hover:shadow-lg hover:-translate-y-1 group">
        <div class="w-12 h-12 bg-primary/10 rounded-xl flex items-center justify-center text-primary mb-6 group-hover:bg-primary group-hover:text-white transition-all duration-300">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.59 14.37a6 6 0 0 1-5.84 7.38v-4.8m5.84-2.58a14.98 14.98 0 0 0 6.16-12.12A14.98 14.98 0 0 0 9.59 8.37m6 6-6-6m0 0a14.98 14.98 0 0 1-6.16 12.12A14.98 14.98 0 0 1 15.59 14.37m-6-6V3.57" />
          </svg>
        </div>
        <h4 class="text-xl font-bold text-primary mb-3">{t.card3Title}</h4>
        <p class="text-text-light text-sm leading-relaxed">
          {t.card3Desc}
        </p>
      </div>

      <!-- Card 4: Participants -->
      <div class="bg-warm/30 hover:bg-warm/50 border border-primary/5 rounded-2xl p-8 transition-all duration-300 hover:shadow-lg hover:-translate-y-1 group">
        <div class="w-12 h-12 bg-primary/10 rounded-xl flex items-center justify-center text-primary mb-6 group-hover:bg-primary group-hover:text-white transition-all duration-300">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6">
            <path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 0 0 3.741-.479 3 3 0 0 0-4.682-2.72m.94 3.198.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0 1 12 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 0 1 6 18.719m12 0a5.971 5.971 0 0 0-.941-3.197m0 0A5.995 5.995 0 0 0 12 12.75a5.995 5.995 0 0 0-5.058 2.772m0 0a3 3 0 0 0-4.681 2.72 8.986 8.986 0 0 0 3.74.477m.94-3.197a5.971 5.971 0 0 0-.94 3.197M15 6.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm6 3a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Zm-13.5 0a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Z" />
          </svg>
        </div>
        <h4 class="text-xl font-bold text-primary mb-3">{t.card4Title}</h4>
        <p class="text-text-light text-sm leading-relaxed">
          {t.card4Desc}
        </p>
      </div>

    </div>
  </div>
</section>
