---
import { getTranslations } from '../utils/translations';

const currentLocale = Astro.currentLocale || 'zh-tw';
const t = getTranslations(currentLocale);
---
<section id="intro" class="py-20 md:py-28 bg-warm-light relative">
  <!-- Subtle top/bottom borders -->
  <div class="absolute top-0 left-0 w-full h-[1px] bg-gradient-to-r from-transparent via-primary/10 to-transparent"></div>
  <div class="absolute bottom-0 left-0 w-full h-[1px] bg-gradient-to-r from-transparent via-primary/10 to-transparent"></div>

  <div class="container mx-auto px-6 max-w-[1100px]">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
      
      <!-- Left side: Poetic verses and Event context -->
      <div class="lg:col-span-7 flex flex-col justify-center">
        <h2 class="text-xs uppercase tracking-widest text-accent font-bold mb-4">{t.introTag}</h2>
        
        <!-- Elegant Highlight Block -->
        <div class="border-l-4 border-accent pl-6 my-6 text-primary/95">
          <p class="text-xl md:text-2xl font-bold leading-relaxed animate-fade-in">
            {currentLocale === 'en' ? 'Uniting the Qiushi spirit with cutting-edge AI.' : '融合求是精神，探索 AI 前沿科技。'}
          </p>
        </div>

        <!-- Description Paragraphs -->
        <div class="mt-8 text-text-light text-base md:text-lg leading-relaxed space-y-6">
          <p>{t.para1}</p>
          <p>{t.para2}</p>
          <p class="text-xs text-text-light/60">
            {t.boardSignature}
          </p>
        </div>
      </div>

      <!-- Right side: Visual graphic/stats card -->
      <div class="lg:col-span-5 flex flex-col gap-8">
        <!-- OpenClaw Blueprint Illustration -->
        <div class="bg-white rounded-3xl overflow-hidden shadow-md border border-primary/5 transition-transform duration-500 hover:scale-[1.01] group">
          <img 
            src="/images/openclaw_blueprint.png" 
            alt="OpenClaw System Blueprint" 
            class="w-full h-auto object-cover transition-transform duration-700 group-hover:scale-102"
          />
        </div>

        <div class="bg-white rounded-3xl p-8 md:p-10 shadow-lg border border-primary/5 relative overflow-hidden group">
          <!-- Decorative circle background -->
          <div class="absolute -right-16 -top-16 w-48 h-48 bg-primary/5 rounded-full pointer-events-none group-hover:scale-110 transition-transform duration-500"></div>
          
          <h3 class="text-lg font-bold text-primary mb-6 pb-4 border-b border-primary/10">{t.milestoneTitle}</h3>
          
          <div class="space-y-6">
            <!-- Stat 1 -->
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 bg-primary/10 rounded-xl flex items-center justify-center text-primary shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15.362 5.214A8.252 8.252 0 0 1 12 21 8.25 8.25 0 0 1 6.038 7.047 8.287 8.287 0 0 0 9 9.601a8.983 8.983 0 0 1 3.361-6.867 8.21 8.21 0 0 0 3 2.48Z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 18a3.75 3.75 0 0 0 .495-7.467 5.99 5.99 0 0 0-1.925 3.546 5.974 5.974 0 0 1-2.133-1A3.75 3.75 0 0 0 12 18Z" />
                </svg>
              </div>
              <div>
                <h4 class="font-bold text-primary text-sm">{t.stat1Title}</h4>
                <p class="text-xs text-text-light mt-1">{t.stat1Desc}</p>
              </div>
            </div>

            <!-- Stat 2 -->
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 bg-primary/10 rounded-xl flex items-center justify-center text-primary shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5m-9-6h.008v.008H12v-.008ZM12 15h.008v.008H12V15Zm0 2.25h.008v.008H12v-.008ZM9.75 15h.008v.008H9.75V15Zm0 2.25h.008v.008H9.75v-.008ZM7.5 15h.008v.008H7.5V15Zm0 2.25h.008v.008H7.5v-.008Zm6.75-4.5h.008v.008h-.008v-.008Zm0 2.25h.008v.008h-.008V15Zm0 2.25h.008v.008h-.008v-.008Zm2.25-4.5h.008v.008H16.5v-.008Zm0 2.25h.008v.008H16.5V15Z" />
                </svg>
              </div>
              <div>
                <h4 class="font-bold text-primary text-sm">{t.stat2Title}</h4>
                <p class="text-xs text-text-light mt-1">{t.stat2Desc}</p>
              </div>
            </div>

            <!-- Stat 3 -->
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 bg-accent/10 rounded-xl flex items-center justify-center text-accent shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 18.75h-9m9 0a3 3 0 0 1 3 3h-15a3 3 0 0 1 3-3m9 0v-3.375c0-.621-.503-1.125-1.125-1.125h-.871M7.5 18.75v-3.375c0-.621.503-1.125 1.125-1.125h.872m5.007 0H9.497m5.007 0a3.375 3.375 0 0 1-5.007 0m7.007-4.143a4.49 4.49 0 0 0 1.667-3.431 3.375 3.375 0 0 0-6.75 0 4.49 4.49 0 0 0 1.668 3.43m4.707 0A5.993 5.993 0 0 0 12 12.75a5.993 5.993 0 0 0-3.098-1.258m8.948-2.554a6 6 0 1 1-12 0 6 6 0 0 1 12 0Z" />
                </svg>
              </div>
              <div>
                <h4 class="font-bold text-accent text-sm">{t.stat3Title}</h4>
                <p class="text-xs text-text-light mt-1">{t.stat3Desc}</p>
              </div>
            </div>
          </div>
        </div>
      </div>
      
    </div>
  </div>
</section>
