---
import { getTranslations } from '../utils/translations';

const currentLocale = Astro.currentLocale || 'zh-tw';
const t = getTranslations(currentLocale);
---
<section class="relative bg-primary text-white overflow-hidden py-24 md:py-32 flex flex-col justify-center min-h-[85vh]">
  <!-- Abstract background decorations -->
  <div class="absolute inset-0 bg-radial-at-t from-primary via-primary-hover to-primary opacity-90 z-0"></div>
  
  <!-- Subtle runners/track decorative SVG background -->
  <div class="absolute inset-0 opacity-10 pointer-events-none z-0">
    <svg class="w-full h-full" xmlns="http://www.w3.org/2000/svg" width="100%" height="100%">
      <defs>
        <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
          <path d="M 40 0 L 0 0 0 40" fill="none" stroke="rgba(255,255,255,0.15)" stroke-width="1"/>
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#grid)" />
    </svg>
  </div>
  
  <!-- Red accent decorative glow -->
  <div class="absolute top-1/4 right-0 w-[300px] h-[300px] bg-accent/20 rounded-full blur-[120px] pointer-events-none z-0"></div>
  <div class="absolute bottom-1/4 left-0 w-[200px] h-[200px] bg-accent/15 rounded-full blur-[90px] pointer-events-none z-0"></div>

  <div class="container mx-auto px-6 max-w-[1100px] relative z-10">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-12 items-center">
      <!-- Left Column -->
      <div class="md:col-span-7 text-center md:text-left flex flex-col items-center md:items-start">
        <!-- Top badge/anniversary tags -->
        <div class="flex flex-wrap justify-center md:justify-start gap-3 mb-6">
          <span class="inline-block bg-accent text-white text-xs font-semibold px-4 py-1.5 rounded-full uppercase tracking-wider shadow-sm">
            {t.ncBadge}
          </span>
          <span class="inline-block bg-white/10 text-white border border-white/20 text-xs font-semibold px-4 py-1.5 rounded-full uppercase tracking-wider shadow-sm">
            {t.naBadge}
          </span>
        </div>

        <!-- Main Title -->
        <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold leading-tight mb-6 tracking-wide drop-shadow-md">
          {t.mainTitleLine1}<br class="hidden sm:inline" />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-white via-warm to-white">
            {t.mainTitleLine2}
          </span>
        </h1>

        <!-- Subtitle -->
        <p class="text-base sm:text-lg md:text-xl text-white/80 max-w-[800px] mb-8 leading-relaxed font-light">
          {t.heroSubtitle}
        </p>

        <!-- Event Date Badge -->
        <div class="bg-white/5 border border-white/10 backdrop-blur-md rounded-2xl p-5 mb-8 w-full max-w-[500px]">
          <div class="text-xs uppercase tracking-wider text-white/60 mb-2 font-semibold">{t.heroTimeLabel}</div>
          <div class="text-lg sm:text-xl md:text-2xl font-bold text-accent">
            {t.heroTimeVal}
          </div>
          <div class="text-xs sm:text-sm text-white/70 mt-1">{t.heroTimeSub}</div>
        </div>

        <!-- Actions -->
        <div class="flex flex-col sm:flex-row gap-4 w-full sm:w-auto">
          <a 
            href="#participate" 
            class="bg-accent hover:bg-accent-hover active:bg-accent text-white font-medium px-8 py-4 rounded-xl shadow-lg hover:shadow-accent/25 transition-all duration-300 transform hover:-translate-y-0.5 text-center"
          >
            {t.btnLearn}
          </a>
          <a 
            href="#intro" 
            class="bg-white/10 hover:bg-white/20 active:bg-white/10 text-white border border-white/20 font-medium px-8 py-4 rounded-xl transition-all duration-300 text-center"
          >
            {t.btnIntro}
          </a>
        </div>
      </div>

      <!-- Right Column (Hero Image) -->
      <div class="md:col-span-5 flex justify-center w-full">
        <div class="relative w-full max-w-[380px] aspect-square rounded-3xl overflow-hidden shadow-2xl border-4 border-white/15 bg-white/5 transition-transform duration-500 hover:scale-[1.02] group">
          <!-- Decorative glow effect behind the image -->
          <div class="absolute inset-0 bg-gradient-to-tr from-accent/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 z-10 pointer-events-none"></div>
          <img 
            src="/images/hero_ai.png" 
            alt="ZJUAANC AI Agent Seminar Hero Illustration" 
            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
          />
        </div>
      </div>
    </div>
  </div>
</section>
